    Component.onCompleted: {
        check("built-in count 20", pm.builtInProviders.length === 20);
        check("custom parsed: 1 valid, name with comma/pipe kept", pm.customProviders.length === 1 && pm.customProviders[0].name === "My, Site|x" && pm.customProviders[0].url === "https://example.org/chat");
        check("enabled subset", pm.enabledProviders.length === 3 + 0 && pm.enabledProviders.some(p => p.id === "githubcopilot") && !pm.enabledProviders.some(p => p.id === "claude"));
        plasmoid.configuration.showClaude = true;
        check("enabledProviders reactive", pm.enabledProviders.some(p => p.id === "claude"));
        check("providerForUrl exact", pm.providerForUrl("https://chatgpt.com").id === "chatgpt");
        check("providerForUrl path", pm.providerForUrl("https://claude.ai/new?x").id === "claude");
        check("providerForUrl legacy grok", pm.providerForUrl("https://x.com/i/grok").id === "grok");
        check("providerForUrl legacy ddg", pm.providerForUrl("https://duckduckgo.com/chat").id === "duckduckgo");
        check("providerForUrl custom", pm.providerForUrl("https://example.org/chat").custom === true);
        check("no false prefix match", pm.providerForUrl("https://chatgpt.com.evil.example") === null);
        check("legacyUrlMap", pm.legacyUrlMap()["https://x.com/i/grok"] === "https://grok.com");
        check("iconSource colorful", pm.iconSource(pm.providerForUrl("https://chatgpt.com"), "colorful", "dark") === "assets/colorful/chatgpt.svg");
        check("iconSource filled fallback for copilot colorful", pm.iconSource(pm.providerForUrl("https://github.com/copilot"), "colorful", "dark") === "assets/filled/githubcopilot-dark.svg");
        check("iconSource outlined fallback filled (qwen)", pm.iconSource(pm.providerForUrl("https://chat.qwen.ai"), "outlined", "light") === "assets/filled/qwen-light.svg");
        check("iconSource none for grok", pm.iconSource(pm.providerForUrl("https://grok.com"), "filled", "dark") === "");
        check("iconSource lobechat filled->colorful", pm.iconSource(pm.providerForUrl("https://lobechat.com/chat"), "filled", "dark") === "assets/colorful/lobechat.svg");
        check("isAuthUrl google", pm.isAuthUrl("https://accounts.google.com/o/oauth2/v2/auth?x"));
        check("isAuthUrl github login", pm.isAuthUrl("https://github.com/login?return_to=x"));
        check("isAuthUrl generic /authorize", pm.isAuthUrl("https://auth.example.com/authorize?client_id=1"));
        check("isAuthUrl sign_in", pm.isAuthUrl("https://chat.deepseek.com/sign_in"));
        check("not auth: docs link", !pm.isAuthUrl("https://docs.example.com/guide"));
        check("not auth: non-http", !pm.isAuthUrl("mailto:x@y"));
        const qtUa = "Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) QtWebEngine/6.11.2 Chrome/140.0.0.0 Safari/537.36";
        check("UA default kept", pm.effectiveUserAgent(qtUa, null) === qtUa);
        plasmoid.configuration.compatibilityUserAgent = true;
        check("UA compat strips token", pm.effectiveUserAgent(qtUa, null) === "Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/140.0.0.0 Safari/537.36");
        plasmoid.configuration.customUserAgent = "Custom/1";
        check("UA custom wins", pm.effectiveUserAgent(qtUa, null) === "Custom/1");
        check("serialize custom", pm.serializeCustomProviders([{name:" A ", url:"a.example"}, {name:"", url:"x"}]) === '[{"name":"A","url":"https://a.example"}]');
        check("nameForUrl host fallback", pm.nameForUrl("https://unknown.example/x") === "unknown.example");
        check("categoryName", pm.categoryName("code").length > 0 && pm.categoryName("custom").length > 0);
        console.log(failures === 0 ? "ALL PASS" : failures + " FAILURES");
        Qt.quit();
    }
